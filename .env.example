# คัดลอกไฟล์นี้เป็น .env ก่อนรัน (docker-compose อ่านค่าจากไฟล์ .env ด้วย)
# ค่าในนี้เป็นค่าสำหรับเทสบนเครื่องตัวเอง -- ตอนขึ้นเครื่องจริงต้องเปลี่ยนที่มีคำว่า "เปลี่ยน" ทุกตัว

# --- Postgres ---
POSTGRES_USER=stock
# เปลี่ยน: compose จะไม่สตาร์ทถ้าไม่ตั้งค่านี้
POSTGRES_PASSWORD=stockpass
POSTGRES_DB=stockscan
POSTGRES_PORT=5433

# --- App ---
# ใช้ตอนรัน next dev บนเครื่องตัวเอง (ต่อเข้า postgres ที่ docker เปิดพอร์ตไว้)
DATABASE_URL=postgresql://stock:stockpass@localhost:5433/stockscan?schema=public

# เปลี่ยน: ความลับสำหรับเซ็น session cookie ใครรู้ค่านี้ปลอมสิทธิ์ admin ได้
# compose จะไม่สตาร์ทถ้าไม่ตั้ง สุ่มค่าใหม่ด้วย: openssl rand -base64 32
AUTH_SECRET=dev-secret-change-me-please-32-chars-min

# ส่ง session cookie เฉพาะบน https หรือไม่
# เข้าผ่าน http:// ตรงๆ (NAS ในวงแลน) = false, มี reverse proxy https อยู่หน้า = true
COOKIE_SECURE=false

# --- ผู้ดูแลระบบคนแรก ---
# ใช้ตอนฐานข้อมูลยังว่างเท่านั้น (ครั้งแรกที่สตาร์ท) หลังจากนั้นไม่ถูกใช้อีก
# ถ้าไม่ตั้ง ADMIN_PASSWORD แอปจะไม่สตาร์ท -- ตั้งใจให้เห็นตั้งแต่ต้น ดีกว่าได้รหัสตายตัว
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=ผู้ดูแลระบบ

# พอร์ตที่เว็บจะเปิด
APP_PORT=3000

# --- AI เติมข้อมูลสินค้า (ไม่บังคับ - ไม่ตั้งปุ่ม AI จะแจ้งเตือนแทน) ---
# คีย์อยู่ฝั่ง server เท่านั้น ไม่ผ่าน browser (ห้ามใส่คีย์จริงในไฟล์นี้ - ไฟล์นี้ขึ้น git)
# AI_PROVIDER: openai (OpenRouter) หรือ anthropic (relay ทรง Anthropic) - สลับได้ไม่ต้องแก้โค้ด
AI_PROVIDER=openai
AI_API_BASE=https://openrouter.ai/api
AI_API_KEY=
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
