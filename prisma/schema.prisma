// Prisma schema - ระบบเช็คสต็อกด้วยการสแกน serial
// serial ทุกตัวไม่ซ้ำกันทั้งคลัง (1 serial = 1 ชิ้น)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum UnitStatus {
  IN_STOCK // อยู่ในคลัง
  OUT // เบิกออกไปแล้ว
}

/// สินค้านับสต็อก 2 แบบ: รายชิ้นตาม serial หรือนับเป็นจำนวน (ตู้แร็ค, รางไฟ, ...)
enum TrackingType {
  SERIAL // 1 serial = 1 ชิ้น (AP, Switch, กล้อง)
  QUANTITY // เก็บเป็นจำนวน กรอกตัวเลข (ตู้แร็ค, รางไฟ)
}

enum ScanType {
  IN
  OUT
  AUDIT
}

/// ผลของการสแกนแต่ละครั้ง เก็บทั้งที่สำเร็จและไม่สำเร็จเพื่อย้อนดูได้
enum ScanResult {
  CREATED // รับเข้า: serial ใหม่ ยังไม่เคยมีในระบบ
  RETURNED // รับเข้า: serial เคยถูกเบิกออก ตอนนี้รับกลับเข้าคลัง
  DUPLICATE // สแกนซ้ำ (รับเข้าทั้งที่ยังอยู่ในคลัง / audit ยิงซ้ำในรอบเดียวกัน)
  PRODUCT_MISMATCH // รับเข้า: serial นี้เคยผูกกับสินค้าตัวอื่น
  OK // เบิกออก/ตรวจนับสำเร็จ
  ALREADY_OUT // เบิกออก: ถูกเบิกไปแล้ว
  UNKNOWN_SERIAL // ไม่รู้จัก serial นี้
  NOT_IN_SCOPE // ตรวจนับ: serial อยู่นอกประเภทของที่กำลังนับรอบนี้
  FOUND_BUT_OUT // ตรวจนับ: ระบบว่าเบิกออกไปแล้ว แต่เจอของจริงในคลัง (ของเกิน)
  MISSING // ตรวจนับ: ระบบว่ามีของ แต่นับไม่เจอ (ของหาย) - บันทึกตอนปิดรอบแบบปรับสต็อก
}

enum OutReason {
  SALE // ขาย
  INTERNAL_USE // ใช้ภายใน
  DAMAGED // ชำรุด/ทิ้ง
  RETURN_SUPPLIER // ส่งคืนผู้ขาย
  OTHER // อื่นๆ
}

enum AuditStatus {
  OPEN
  CLOSED
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  displayName   String
  role          Role     @default(STAFF)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  scanLogs      ScanLog[]
  auditSessions AuditSession[]
  serialImages  SerialImage[]
  exportJobs    ExportJob[]
}

/// ลูกค้าที่ซื้อสินค้า
model Customer {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scanLogs  ScanLog[]
  projects  Project[]
}

/// งาน/โครงการที่ลูกค้าแต่ละคนซื้อของเป็นชุด - เช่น ลูกค้าติดกล้องซื้อ NVR+กล้อง = โปรเจคกล้อง
/// ผูกกับรายการขาย (ScanLog OUT+SALE) เพื่อดูว่าลูกค้าคนนี้ซื้อของเป็นงานอะไรบ้าง
model Project {
  id         String   @id @default(cuid())
  customerId String
  name       String
  note       String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  scanLogs ScanLog[]

  @@index([customerId, active])
}

model Category {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  /// ประเภทของที่ต้องแนบรูปอุปกรณ์ก่อนส่งเครม (เช่น NVR) - เปิด/ปิดได้ที่หน้าประเภทของ
  photosEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      Product[]
  auditSessions AuditSession[]
}

model Product {
  id         String   @id @default(cuid())
  sku        String   @unique
  name       String
  brand      String?
  note       String?
  categoryId String
  /// นับสต็อกแบบราย serial หรือแบบจำนวน - เปลี่ยนได้เฉพาะตอนยังไม่มีของ/ประวัติ
  trackingType TrackingType @default(SERIAL)
  /// ยอดคงเหลือสำหรับสินค้าแบบ QUANTITY (สินค้าแบบ SERIAL นับจาก SerialUnit แทน)
  stockQty Int @default(0)
  /// หน่วยนับสำหรับสินค้าแบบ QUANTITY เช่น อัน, เมตร, กล่อง
  unitLabel String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  units    SerialUnit[]
  scanLogs ScanLog[]

  @@index([categoryId])
  @@index([brand])
}

/// ผู้ขาย/ตัวแทนจำหน่ายที่รับของเข้ามา เช่น SiS
model Vendor {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  note      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units    SerialUnit[]
  scanLogs ScanLog[]
}

model SerialUnit {
  id         String     @id @default(cuid())
  serial     String     @unique
  productId  String
  status     UnitStatus @default(IN_STOCK)
  /// ผู้ขายที่รับของชิ้นนี้เข้ามาครั้งล่าสุด
  vendorId   String?
  receivedAt DateTime?
  releasedAt DateTime?
  lastScanAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  vendor   Vendor?   @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  scanLogs ScanLog[]
  images   SerialImage[]

  @@index([productId, status])
  @@index([status])
  @@index([vendorId])
}

/// บันทึกทุกครั้งที่มีการยิงสแกน (สำเร็จหรือไม่ก็เก็บ) ใช้ย้อนรอยว่าใครทำอะไรเมื่อไหร่
/// รายการของสินค้าแบบ QUANTITY ไม่มี serial (serial = null) แต่มี quantity เป็นจำนวนที่ขยับ
model ScanLog {
  id             String     @id @default(cuid())
  serial         String?
  /// จำนวนที่ขยับในรายการนี้ - ของ SERIAL = 1 เสมอ, ของ QUANTITY = จำนวนที่กรอก
  quantity       Int        @default(1)
  type           ScanType
  result         ScanResult
  accepted       Boolean // ระบบรับรายการนี้หรือปฏิเสธ
  message        String?
  reason         OutReason?
  note           String?
  userId         String
  productId      String?
  unitId         String?
  /// ผู้ขายที่ระบุไว้ตอนรับเข้า - เก็บซ้ำที่ log เพื่อให้ย้อนดูได้ว่ารอบนั้นรับจากใคร
  /// แม้ของชิ้นเดิมจะถูกรับเข้าใหม่จากผู้ขายรายอื่นทีหลัง
  vendorId       String?
  /// ลูกค้าที่ซื้อสินค้า - ใช้กับรายการเบิกออกเหตุผล SALE
  customerId     String?
  /// โปรเจค/งานที่ลูกค้าซื้อของชุดนี้เข้า - ผูกตอนเบิกขาย ย้ายได้ที่หน้าประวัติ
  projectId      String?
  auditSessionId String?
  createdAt      DateTime   @default(now())
  /// อ้างถึงรายการ OUT ที่รายการนี้คืนของให้ (กันคืนซ้ำ - 1 รายการคืนได้ครั้งเดียว)
  reversesId     String?  @unique

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  unit         SerialUnit?   @relation(fields: [unitId], references: [id], onDelete: SetNull)
  vendor       Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  auditSession AuditSession? @relation(fields: [auditSessionId], references: [id], onDelete: Cascade)
  reverses   ScanLog?  @relation("ScanLogReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy ScanLog?  @relation("ScanLogReversal")

  @@index([type, createdAt])
  @@index([serial])
  @@index([auditSessionId])
  @@index([userId, createdAt])
  @@index([vendorId])
  @@index([customerId])
  @@index([projectId])
}

/// รอบการตรวจนับ 1 รอบ - เปิดรอบ ยิงของ แล้วปิดรอบเพื่อดูผลต่าง
model AuditSession {
  id          String      @id @default(cuid())
  name        String
  status      AuditStatus @default(OPEN)
  categoryId  String? // ถ้าระบุ = นับเฉพาะประเภทนี้, ถ้าไม่ระบุ = นับทั้งคลัง (รอบเก่า)
  /// ขอบเขตรอบใหม่แบบเลือกได้หลายค่า - ว่างทั้งคู่ = ทั้งคลัง (รวมกับ categoryId แบบ union)
  categoryIds String[] @default([])
  productIds  String[] @default([])
  startedById String
  startedAt   DateTime    @default(now())
  closedAt    DateTime?
  note        String?
  /// สรุปผลตอนปิดรอบ (เก็บเป็น snapshot กันตัวเลขเพี้ยนเมื่อสต็อกเปลี่ยนทีหลัง)
  report      Json?

  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  startedBy User      @relation(fields: [startedById], references: [id], onDelete: Restrict)
  scans     ScanLog[]

  @@index([status, startedAt])
}

/// รูปอุปกรณ์ของสินค้ารายชิ้น (ผูกกับ serial) - ใช้ยืนยันตัวเครื่องตอนเครม
/// เก็บไบต์ไว้ในฐานข้อมูลเลย เพื่อให้ติดไปกับ backup ของฐานและไม่หายตอน rebuild container
model SerialImage {
  id           String   @id @default(cuid())
  unitId       String
  /// คำอธิบายสั้น ๆ ของรูป เช่น "รูปตัวอุปกรณ์"
  label        String   @default("รูปตัวอุปกรณ์")
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById String
  createdAt    DateTime @default(now())

  unit       SerialUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  uploadedBy User       @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([unitId, createdAt])
}

/// งาน export ไฟล์ขนาดใหญ่ - สร้างไฟล์เบื้องหลังแล้วค่อยดาวน์โหลด
/// เก็บไฟล์ไว้ชั่วคราวในเครื่อง (ไม่เก็บไบต์ในฐานข้อมูล) และลบเมื่อหมดอายุ
enum ExportJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

model ExportJob {
  id          String          @id @default(cuid())
  userId      String
  type        String
  format      String
  params      Json
  status      ExportJobStatus @default(PENDING)
  progress    Int             @default(0)
  fileName    String?
  contentType String?
  size        Int?
  error       String?
  createdAt   DateTime        @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  expiresAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([expiresAt])
}
